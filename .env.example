# FlowForge Analytics backend configuration.
# Copy this file to backend/.env (or .env in the repository root) and fill in what you need.
# Every value is optional; the application runs without AI and without Make.com.
# Never commit the real .env file.

# Storage: SQLite database, original uploads, working copies and report files.
# Relative paths are resolved from the backend directory.
DATA_DIR=data

# Upload limits
MAX_UPLOAD_MB=10
MAX_ROWS=500000
MAX_COLUMNS=200

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: serve the built frontend from the API server (e.g. ../frontend/dist).
FRONTEND_DIST_DIR=

# Optional: public address of this server, used for report links sent to Make.com.
PUBLIC_BASE_URL=

LOG_LEVEL=INFO

# AI insights (optional). With no key, FlowForge uses its rule-based insights.
# Only aggregated results are sent to the provider, never raw rows.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4000

# Make.com automation (optional). The URL stays on the server and must use HTTPS.
MAKE_WEBHOOK_URL=
# Optional shared secret; adds an X-FlowForge-Signature HMAC-SHA256 header to each request.
MAKE_WEBHOOK_SECRET=
MAKE_TIMEOUT_SECONDS=10
# Send every newly generated report to Make.com automatically.
AUTOMATION_TRIGGER_ON_REPORT=false
