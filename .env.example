# Copy this file to backend/.env and fill in real values locally.
# Never commit the real .env file. Every value below is a placeholder.

# --- Uploads -----------------------------------------------------------
# Largest CSV upload accepted, in megabytes
MAX_UPLOAD_MB=5
# Largest number of data rows and columns accepted
MAX_ROWS=100000
MAX_COLUMNS=50

# Where the React dev server runs (used for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Folder for analysis results and generated PDF reports (default: backend/data)
# DATA_DIR=./data

# --- AI insights (optional) ---------------------------------------------
# Anthropic API key. Leave blank to use the rule-based fallback, which is
# clearly labelled as not AI-generated.
AI_API_KEY=
# Model used for insights
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=60

# --- Make.com webhook (optional) ----------------------------------------
# Custom webhook URL from your Make scenario, e.g.
# https://hook.eu1.make.com/your-webhook-id  (treat it as a secret)
MAKE_WEBHOOK_URL=
# Optional: API key configured on the Make webhook (sent as x-make-apikey)
MAKE_WEBHOOK_API_KEY=
MAKE_TIMEOUT_SECONDS=10
