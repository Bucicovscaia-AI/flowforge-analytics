# Copy this file to backend/.env and fill in real values locally.
# Never commit the real .env file.

# Largest CSV upload accepted, in megabytes
MAX_UPLOAD_MB=5

# Where the React dev server runs (used for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Stage 7 (optional): external AI API key. Leave blank to disable AI insights.
AI_API_KEY=

# Stage 8 (optional): Make.com webhook URL. Leave blank to disable.
MAKE_WEBHOOK_URL=
